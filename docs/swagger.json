{
    "swagger": "2.0",
    "info": {
        "description": "Graph-guided adaptive study plans using Amazon Bedrock.",
        "title": "AxiomEngine API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/api/v1/adaptive-plan": {
            "post": {
                "security": [
                    {
                        "InternalToken": []
                    }
                ],
                "description": "Generate a graph-guided study plan for known topics and a VARK profile.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Adaptive Plan"
                ],
                "summary": "Generate adaptive study plan",
                "operationId": "generateAdaptivePlan",
                "parameters": [
                    {
                        "description": "Student profile and failed concepts",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.AdaptivePlanRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.PlanResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "413": {
                        "description": "Request Entity Too Large",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "415": {
                        "description": "Unsupported Media Type",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "502": {
                        "description": "Upstream failure or no usable item for a requested topic",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Temporary unavailability, upstream throttling or server shutdown",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        },
                        "headers": {
                            "Retry-After": {
                                "type": "integer",
                                "description": "Seconds to wait before retrying"
                            }
                        }
                    },
                    "504": {
                        "description": "Gateway Timeout",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/tutor/student/{student_id}/cognitive-graph": {
            "get": {
                "security": [
                    {
                        "InternalToken": []
                    }
                ],
                "description": "Return concept nodes annotated with failed, learning or mastered state.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Tutor"
                ],
                "summary": "Get cognitive shadow graph",
                "operationId": "getCognitiveGraph",
                "parameters": [
                    {
                        "type": "string",
                        "example": "student-42",
                        "description": "Student identifier",
                        "name": "student_id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "Polymorphism,Recursion",
                        "description": "Comma-separated failed topic names",
                        "name": "topics",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "string",
                        "example": "Recursion",
                        "description": "Center the subgraph on one topic",
                        "name": "target_topic",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.CognitiveGraphResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    },
                    "429": {
                        "description": "Too Many Requests",
                        "schema": {
                            "$ref": "#/definitions/domain.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Return process liveness without requiring authorization.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "System"
                ],
                "summary": "Health check",
                "operationId": "getHealth",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "domain.AdaptivePlanRequest": {
            "type": "object",
            "properties": {
                "course_id": {
                    "description": "CourseID identifies the course within which the adaptive plan is scoped.",
                    "type": "string",
                    "example": "cs101"
                },
                "failed_topics": {
                    "description": "FailedTopics is a non-empty list of knowledge-graph node names\nrepresenting concepts the student has not yet mastered.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "Polymorphism",
                        "Recursion"
                    ]
                },
                "student_id": {
                    "description": "StudentID is the platform-level identifier for the learner.",
                    "type": "string",
                    "example": "student-42"
                },
                "telemetry": {
                    "description": "Telemetry carries optional client-side diagnostic metadata.\nWhen nil, telemetry is omitted from the serialized payload.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.Telemetry"
                        }
                    ]
                },
                "vark_profile": {
                    "description": "VARKProfile specifies the student's dominant learning modality.\nAccepted values: \"visual\", \"auditory\", \"read_write\", \"kinesthetic\".",
                    "type": "string",
                    "example": "visual"
                }
            }
        },
        "domain.CognitiveGraphResponse": {
            "type": "object",
            "properties": {
                "edges": {
                    "description": "Edges contains directed relationships between nodes in the subgraph.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.VisualEdge"
                    }
                },
                "nodes": {
                    "description": "Nodes contains the filtered concept nodes, each annotated\nwith the student's cognitive state.",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.VisualNode"
                    }
                }
            }
        },
        "domain.ErrorResponse": {
            "type": "object",
            "properties": {
                "details": {
                    "description": "Details provides a human-readable explanation of the error cause.\nOmitted when empty.",
                    "type": "string",
                    "example": "failed_topics must contain at least one topic"
                },
                "error": {
                    "description": "Error is a machine-readable error code (e.g., \"validation_error\",\n\"rate_limit_exceeded\", \"service_unavailable\").",
                    "type": "string",
                    "example": "validation_error"
                }
            }
        },
        "domain.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "description": "Status is always \"ok\" when the service is running.",
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "domain.PipelineMeta": {
            "type": "object",
            "properties": {
                "items_after_validation": {
                    "description": "ItemsValidated is the count of study items remaining after the\ngraph validation stage retains requested topics and their prerequisites.",
                    "type": "integer",
                    "example": 5
                },
                "items_dropped": {
                    "description": "ItemsDropped counts distinct items outside the requested prerequisite closure.",
                    "type": "integer",
                    "example": 1
                },
                "items_generated": {
                    "description": "ItemsGenerated is the total number of study items returned across\nall per-topic LLM calls before deduplication.",
                    "type": "integer",
                    "example": 6
                },
                "llm_latency_ms": {
                    "description": "LLMLatencyMs is the wall-clock time (milliseconds) spent waiting\nfor all parallel LLM calls to complete.",
                    "type": "number",
                    "example": 3240.5
                },
                "subgraph_tuples": {
                    "description": "SubgraphTuples is the number of knowledge-graph triples extracted\nby the BFS subgraph traversal for the given failed topics.",
                    "type": "integer",
                    "example": 12
                },
                "topics_processed": {
                    "description": "TopicsProcessed is the count of failed topics that were individually\nsent to the LLM via the parallel fan-out stage.",
                    "type": "integer",
                    "example": 2
                },
                "total_latency_ms": {
                    "description": "TotalLatencyMs is the end-to-end pipeline duration (milliseconds)\nfrom request receipt to response serialization.",
                    "type": "number",
                    "example": 3312.8
                }
            }
        },
        "domain.PlanItem": {
            "type": "object",
            "properties": {
                "explanation": {
                    "description": "Explanation is a concise rationale generated by the LLM describing\nwhy this topic is relevant to the student's failed assessment. It contains\nat most 1000 runes, with Unicode control and format characters removed.",
                    "type": "string",
                    "maxLength": 1000,
                    "example": "Polymorphism allows objects to be treated as instances of their parent class."
                },
                "prerequisite_chain": {
                    "description": "PrerequisiteChain lists the ordered prerequisite path leading to this\ntopic, extracted from the knowledge graph via topological sort.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "Variables",
                        "Objects",
                        "Classes",
                        "Inheritance"
                    ]
                },
                "priority": {
                    "description": "Priority determines the recommended study order. 1 = highest priority\n(study first). Included prerequisites precede their dependent topics.",
                    "type": "integer",
                    "example": 1
                },
                "resources": {
                    "description": "Resources contains 0-3 learning resources whose type strictly matches\nthe student's VARK profile.",
                    "type": "array",
                    "maxItems": 3,
                    "items": {
                        "$ref": "#/definitions/domain.Resource"
                    }
                },
                "topic": {
                    "description": "Topic is the knowledge-graph node name this item targets.",
                    "type": "string",
                    "example": "Polymorphism"
                }
            }
        },
        "domain.PlanResponse": {
            "type": "object",
            "properties": {
                "_meta": {
                    "description": "Meta exposes internal pipeline metrics for observability dashboards.\nSerialized under the \"_meta\" key to distinguish it from domain data.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/domain.PipelineMeta"
                        }
                    ]
                },
                "course_id": {
                    "description": "CourseID is echoed from the request for client-side correlation.",
                    "type": "string",
                    "example": "cs101"
                },
                "items": {
                    "description": "Items is the ordered sequence of study items, priority-sorted (1 = study first).",
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/domain.PlanItem"
                    }
                },
                "student_id": {
                    "description": "StudentID is echoed from the request for client-side correlation.",
                    "type": "string",
                    "example": "student-42"
                }
            }
        },
        "domain.Resource": {
            "type": "object",
            "properties": {
                "resource_type": {
                    "description": "ResourceType is normalized to lowercase and restricted to these values per VARK:\n  kinesthetic: \"exercise\", \"lab\", \"coding-challenge\"\n  visual:      \"video\", \"diagram\", \"infographic\"\n  auditory:    \"podcast\", \"lecture\", \"audio-course\"\n  read_write:  \"article\", \"textbook\", \"documentation\"",
                    "type": "string",
                    "example": "video"
                },
                "title": {
                    "description": "Title is a name of at most 200 runes, with Unicode control and format characters removed.",
                    "type": "string",
                    "maxLength": 200,
                    "example": "Polymorphism in Java – Visual Guide"
                },
                "url": {
                    "description": "URL is an absolute HTTP(S) link without userinfo, at most 2048 characters.",
                    "type": "string",
                    "maxLength": 2048,
                    "example": "https://example.com/polymorphism-visual"
                }
            }
        },
        "domain.Telemetry": {
            "type": "object",
            "properties": {
                "client_version": {
                    "description": "ClientVersion identifies the frontend application version for compatibility tracking.",
                    "type": "string",
                    "example": "2.4.1"
                },
                "duration_ms": {
                    "description": "DurationMs records how long the client spent on the assessment before requesting a plan.",
                    "type": "number",
                    "example": 12345.6
                },
                "session_id": {
                    "description": "SessionID is a client-generated correlation identifier.",
                    "type": "string",
                    "example": "sess-a1b2c3"
                },
                "timestamp_unix": {
                    "description": "TimestampUnix is the Unix epoch (seconds) at which the client created the request.",
                    "type": "integer",
                    "example": 1713340800
                }
            }
        },
        "domain.VisualEdge": {
            "type": "object",
            "properties": {
                "relation": {
                    "description": "Relation is the edge label (e.g., \"depends_on\", \"is_a\").",
                    "type": "string",
                    "example": "depends_on"
                },
                "source": {
                    "description": "Source is the ID of the originating node (the dependent concept).",
                    "type": "string",
                    "example": "Polymorphism"
                },
                "target": {
                    "description": "Target is the ID of the destination node (the prerequisite concept).",
                    "type": "string",
                    "example": "Inheritance"
                }
            }
        },
        "domain.VisualNode": {
            "type": "object",
            "properties": {
                "cognitive_state": {
                    "description": "CognitiveState indicates the student's cognitive state for this concept.\nPossible values:\n  \"failed\"   -- the student explicitly failed this topic.\n  \"learning\" -- this topic is a prerequisite of a failed topic.\n  \"mastered\" -- no evidence of deficit; presumed mastered.",
                    "type": "string",
                    "example": "failed"
                },
                "id": {
                    "description": "ID is the unique identifier for this node, equal to the knowledge-graph node name.",
                    "type": "string",
                    "example": "Polymorphism"
                },
                "label": {
                    "description": "Label is the human-readable display text for the node.",
                    "type": "string",
                    "example": "Polymorphism"
                }
            }
        }
    },
    "securityDefinitions": {
        "InternalToken": {
            "type": "apiKey",
            "name": "X-Internal-Token",
            "in": "header"
        }
    }
}