# Process environment is read at startup; .env is only loaded by Compose.
# PORT=8080
# AXIOM_AUTH_DISABLED=false
# AXIOM_INTERNAL_TOKEN=  # required unless AXIOM_AUTH_DISABLED=true; do not set both
# AXIOM_INTERNAL_TOKEN_PREVIOUS=  # empty disables the previous token; must differ from the current token
# Tokens require at least 32 visible ASCII characters without whitespace: openssl rand -hex 32
# CORS_ALLOWED_ORIGINS=  # unset disables CORS
# RATE_LIMIT_MAX=50
# RATE_LIMIT_WINDOW=1m
# TRUSTED_PROXIES=  # comma-separated IP addresses or CIDRs; empty disables trust
# REQUEST_TIMEOUT=20s
# LLM_MAX_CONCURRENCY=16
# LLM_QUEUE_TIMEOUT=2s
# LLM_TIMEOUT=15s
# MAX_FAILED_TOPICS=10
# METRICS_ENABLED=false
# GRAPH_FILE=  # unset uses the embedded curriculum
# LOG_LEVEL=info
# BAML_LOG=off
# SHUTDOWN_DRAIN_DELAY=0s
# SHUTDOWN_TIMEOUT=25s  # defaults to max(REQUEST_TIMEOUT + 5s, 11s); minimum 11s

# Amazon Bedrock uses the standard AWS credential provider chain.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# AWS_MAX_ATTEMPTS=3  # integer from 1 to 4294967295; empty values fail startup
# AWS_RETRY_MODE=standard  # standard or adaptive; empty values fail startup
