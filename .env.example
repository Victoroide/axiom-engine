# Process environment is read at startup; .env is only loaded by Compose.
# OPENAI_API_KEY=  # required for openai
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=  # comma-separated key=value pairs
# OTEL_RESOURCE_ATTRIBUTES=  # comma-separated key=value pairs
# OTEL_SERVICE_NAME=axiom-engine
# OTEL_TRACES_SAMPLER=parentbased_always_on
# PORT=8080
# HTTP_LISTENER=fiber  # net-http enables cancellation when a client disconnects
# ANTHROPIC_API_KEY=  # required for anthropic
# AXIOM_AUTH_MODE=shared  # HTTP defaults to shared when unset
# AXIOM_AUTH_DISABLED=false  # true requires AXIOM_AUTH_MODE and both shared tokens to be unset
# AXIOM_INTERNAL_TOKEN=  # required in shared mode
# AXIOM_INTERNAL_TOKEN_PREVIOUS=  # empty disables the previous token; must differ from the current token
# Tokens require at least 32 visible ASCII characters without whitespace: openssl rand -hex 32
# For AXIOM_AUTH_MODE=verified, leave both shared tokens unset and configure the issuer:
# AXIOM_AUTH_ISSUER=https://identity.example/issuer
# AXIOM_AUTH_AUDIENCE=https://api.example/axiom
# AXIOM_AUTH_JWKS_URL=https://identity.example/keys
# AXIOM_AUTH_ALGORITHMS=RS256  # comma-separated subset of RS256 and ES256
# AXIOM_AUTH_TENANT_CLAIM=tenant_id
# AXIOM_AUTH_SCOPE_CLAIM=scope
# AXIOM_AUTH_CLIENT_ID_CLAIM=  # optional top-level claim paired with the client list
# AXIOM_AUTH_REGISTERED_CLIENTS=  # optional comma-separated allowlist paired with the client claim
# CORS_ALLOWED_ORIGINS=  # unset disables CORS
# RATE_LIMIT_MAX=50
# RATE_LIMIT_WINDOW=1m
# TRACING_CAPTURE_CONTENT=false  # false removes content from every receiver; unset or true grants none by itself
# TRACING_CONTENT_DESTINATIONS=  # langsmith, otlp or langsmith,otlp; unset sends structure only
# TRACING_ENABLED=false
# TRUSTED_PROXIES=  # comma-separated IP addresses or CIDRs; empty disables trust
# REDIS_URL=  # unset uses process-local request storage
# AXIOM_TENANT_QUOTA_ENABLED=false  # true requires verified HTTP authentication and Redis
# AXIOM_TENANT_QUOTA_MAX=50  # optional when enabled
# AXIOM_TENANT_QUOTA_WINDOW=1m
# AXIOM_TENANT_QUOTA_OVERRIDES='{"example-tenant":100}'
# REQUEST_TIMEOUT=20s
# PRESERVE_DISPLAY_JOINS=false
# RESOURCE_LINK_CHECK=false
# RESOURCE_LINK_TIMEOUT=3s
# IDEMPOTENCY_MAX_ENTRIES=10000
# IDEMPOTENCY_TTL=24h  # 0s disables response replay
# LANGSMITH_API_KEY=  # required when LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=  # unset omits Langsmith-Project
# LANGSMITH_TRACING=false
# LLM_API_KEY=  # optional for openai-generic
# LLM_BASE_URL=  # required for openai-generic; ollama defaults to http://localhost:11434/v1
# LLM_MAX_CONCURRENCY=16
# LLM_MAX_CONTEXT_EDGES=256
# LLM_MAX_PREREQUISITES=12
# LLM_MAX_REQUEST_INPUT_BYTES=131072
# LLM_MAX_TOPIC_INPUT_BYTES=16384  # Ollama defaults to 4480 at 4096 context tokens
# LLM_MODEL=amazon.nova-micro-v1:0  # Bedrock default; required for other providers
# LLM_OLLAMA_CONTEXT_TOKENS=4096  # match the context provisioned in Ollama
# LLM_PROVIDER=aws-bedrock
# LLM_QUEUE_TIMEOUT=2s
# LLM_TIMEOUT=15s
# MAX_FAILED_TOPICS=10
# MAX_MASTERED_TOPICS=100
# METRICS_ENABLED=false
# GOOGLE_API_KEY=  # required for google-ai
# GRAPH_FILE=  # unset uses the embedded curriculum
# GRAPH_RELOAD_ENABLED=false  # true enables SIGHUP reloads for a local GRAPH_FILE
# LOG_LEVEL=info
# BAML_LOG=off
# SHUTDOWN_DRAIN_DELAY=0s
# SHUTDOWN_TIMEOUT=25s  # defaults to max(REQUEST_TIMEOUT + 5s, 11s); minimum 11s
# SWAGGER_ENABLED=true

# Amazon Bedrock uses the standard AWS credential provider chain.
# BEDROCK_REQUIRE_EXPLICIT_REGION=false  # true requires a valid AWS_REGION at startup
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# AWS_MAX_ATTEMPTS=3  # integer from 1 to 4294967295; empty values fail startup
# AWS_RETRY_MODE=standard  # standard or adaptive; empty values fail startup

# Remote MCP is opt-in: only `axiom-server mcp-http` reads these settings. It also
# requires AXIOM_AUTH_MODE=verified, AXIOM_TENANT_QUOTA_ENABLED=true and REDIS_URL.
# MCP_PUBLIC_URL=https://mcp.example.com/mcp  # exact token audience; must differ from AXIOM_AUTH_AUDIENCE
# MCP_BIND_ADDR=127.0.0.1:8443  # concrete IP address and port; wildcard addresses are rejected
# MCP_TLS_CERT_FILE=/etc/axiom/tls.crt
# MCP_TLS_KEY_FILE=/etc/axiom/tls.key
# MCP_ALLOWED_ORIGINS=https://app.example.com  # default is the origin of MCP_PUBLIC_URL
