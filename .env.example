# Process environment is read at startup; .env is only loaded by Compose.
# OPENAI_API_KEY=  # required for openai
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=  # comma-separated key=value pairs
# OTEL_RESOURCE_ATTRIBUTES=  # comma-separated key=value pairs
# OTEL_SERVICE_NAME=axiom-engine
# OTEL_TRACES_SAMPLER=parentbased_always_on
# PORT=8080
# ANTHROPIC_API_KEY=  # required for anthropic
# AXIOM_AUTH_DISABLED=false
# AXIOM_INTERNAL_TOKEN=  # required unless AXIOM_AUTH_DISABLED=true; do not set both
# AXIOM_INTERNAL_TOKEN_PREVIOUS=  # empty disables the previous token; must differ from the current token
# Tokens require at least 32 visible ASCII characters without whitespace: openssl rand -hex 32
# CORS_ALLOWED_ORIGINS=  # unset disables CORS
# RATE_LIMIT_MAX=50
# RATE_LIMIT_WINDOW=1m
# TRACING_ENABLED=false
# TRUSTED_PROXIES=  # comma-separated IP addresses or CIDRs; empty disables trust
# REDIS_URL=  # unset uses process-local request storage
# REQUEST_TIMEOUT=20s
# RESOURCE_LINK_CHECK=false
# RESOURCE_LINK_TIMEOUT=3s
# IDEMPOTENCY_MAX_ENTRIES=10000
# IDEMPOTENCY_TTL=24h  # 0s disables response replay
# LANGSMITH_API_KEY=  # required when LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_PROJECT=  # unset omits Langsmith-Project
# LANGSMITH_TRACING=false
# LLM_API_KEY=  # optional for openai-generic
# LLM_BASE_URL=  # required for openai-generic; ollama defaults to http://localhost:11434/v1
# LLM_MAX_CONCURRENCY=16
# LLM_MODEL=amazon.nova-micro-v1:0  # Bedrock default; required for other providers
# LLM_PROVIDER=aws-bedrock
# LLM_QUEUE_TIMEOUT=2s
# LLM_TIMEOUT=15s
# MAX_FAILED_TOPICS=10
# MAX_MASTERED_TOPICS=100
# METRICS_ENABLED=false
# GOOGLE_API_KEY=  # required for google-ai
# GRAPH_FILE=  # unset uses the embedded curriculum
# LOG_LEVEL=info
# BAML_LOG=off
# SHUTDOWN_DRAIN_DELAY=0s
# SHUTDOWN_TIMEOUT=25s  # defaults to max(REQUEST_TIMEOUT + 5s, 11s); minimum 11s
# SWAGGER_ENABLED=true

# Amazon Bedrock uses the standard AWS credential provider chain.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
# AWS_MAX_ATTEMPTS=3  # integer from 1 to 4294967295; empty values fail startup
# AWS_RETRY_MODE=standard  # standard or adaptive; empty values fail startup
